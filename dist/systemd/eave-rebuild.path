# Rebuilds eave when config.toml changes (D-22, D-30). `eave-build init` installs it; enable with:
#   systemctl --user enable --now eave-rebuild.path
# A save that doesn't change which plugins are used costs a quick no-op build, and no restart.
# The bar itself reloads config.toml on its own.

[Unit]
Description=Rebuild eave when config.toml changes
Documentation=https://github.com/eaveshell/eave/blob/main/docs/running.md

[Path]
# `eave-build init` writes the real path here when XDG_CONFIG_HOME isn't ~/.config.
PathChanged=%h/.config/eave/config.toml

[Install]
WantedBy=default.target
